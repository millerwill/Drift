				#endif

				float3 vertexValue = ( appendResult90 + mul( temp_cast_0, GetObjectToWorldMatrix() ).x ).xyz;

				#ifdef ASE_ABSOLUTE_VERTEX_POS
					v.vertex.xyz = vertexValue;
